# ---------------------------------------------------------------------------
# ODLAR API (Laravel) environment
# ---------------------------------------------------------------------------
APP_NAME=ODLAR
# local | production. In production the demo account is only seeded with SEED_DEMO=true.
APP_ENV=local
# Required. Generate with `php artisan key:generate --show` and paste here (or inject via the platform).
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=az
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

# PostgreSQL + PostGIS (postgis/postgis:16-3.4-alpine). The postgis extension is created by a migration,
# so DB_USERNAME needs CREATE privilege on the database (the image's default superuser has it).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=odlar
DB_USERNAME=odlar
DB_PASSWORD=odlar

# Bearer-token API: no server-side sessions needed.
SESSION_DRIVER=array
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Alert e-mails are sent synchronously.
QUEUE_CONNECTION=sync

# Default cache (rate limiting, scheduler locks).
CACHE_STORE=file

# --- ML analytics service (../ml FastAPI) ----------------------------------
# Internal base URL of the ML service.
ODLAR_ML_URL=http://ml:8001
# Shared secret sent as X-Internal-Token; must match ODLAR_INTERNAL_TOKEN on the ML service (empty = none).
ODLAR_INTERNAL_TOKEN=
# Per-request timeout (s), retries on connection errors / 5xx, and pause between retries (ms).
ODLAR_ML_TIMEOUT=20
ODLAR_ML_RETRIES=2
ODLAR_ML_RETRY_SLEEP_MS=250
# Cache for proxied ML responses (bodies up to a few hundred KB, so file rather than database).
ODLAR_CACHE_STORE=file
ODLAR_CACHE_TTL=600

# --- Frontend / CORS ---------------------------------------------------------
# Comma-separated allowed origins; the first one is also used for links in alert e-mails.
# https://*.vercel.app preview deployments are always allowed.
FRONTEND_URLS=http://localhost:3000

# --- Mail (risk alert e-mails) ---------------------------------------------
# "log" writes mails to storage/logs/laravel.log; use smtp in production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="alerts@odlar.az"
MAIL_FROM_NAME="${APP_NAME}"

# --- Demo data ---------------------------------------------------------------
# Seed demo@odlar.az / odlar-demo-2026 (subscribed to az-sabirabad and az-qabala) even when APP_ENV=production.
SEED_DEMO=false

# Docker only: port nginx listens on inside the container.
# PORT=8080
